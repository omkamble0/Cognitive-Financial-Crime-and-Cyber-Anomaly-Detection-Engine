# =============================================================================
# FinCipher AI Platform — Production Environment Configuration Blueprint
# =============================================================================

# 1. APPLICATION ENVIRONMENT
ENVIRONMENT=development           # Options: development, testing, staging, production
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4
CORS_ORIGINS=["*"]

# 2. CRYPTOGRAPHY & AUTHENTICATION (CRITICAL)
# In production, JWT_SECRET MUST be generated using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=fincipher-insecure-dev-secret-key-32chars-minimum!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 3. DATABASE & PERSISTENCE (PostgreSQL / Supabase / Neon / RDS)
# If omitted or left empty, FinCipher AI automatically falls back to SQLite
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Optional Supabase REST API credentials
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# 4. REDIS SLIDING WINDOW VELOCITY STORE (Optional: Upstash / AWS ElastiCache / Redis Cloud)
# Falls back to high-speed in-memory velocity cache if Redis is unavailable
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# 5. FINANCIAL CRIME POLICY & SLA THRESHOLDS
SLA_LATENCY_THRESHOLD_MS=3.5
FRAUD_BLOCK_THRESHOLD=0.75
FRAUD_CHALLENGE_THRESHOLD=0.25
MAX_VELOCITY_1M=5
MAX_VELOCITY_1H=20

# 6. RATE LIMITING & SECURITY PERIMETER
RATE_LIMIT_PER_MINUTE=1200
MAX_REQUEST_BODY_BYTES=2097152

# 7. LOGGING & OBSERVABILITY
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
MASK_PII_IN_LOGS=true

# 8. GEN-AI CYBER COPILOT & SAR STUDIO (OPTIONAL)
# Defaults to Autonomous Local Cognitive Heuristic Engine if no API key is supplied
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_HOST=http://localhost:11434
